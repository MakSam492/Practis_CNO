<Page x:Class="CNO.Pages.PatientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Список пациентов"
      FontFamily="Segoe UI">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryHeaderBrush" Color="#FF2D3A4D"/>
        <SolidColorBrush x:Key="PrimaryActionTextBrush" Color="White"/>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFE9ECEF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
        <SolidColorBrush x:Key="LightTextBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="DarkTextBrush" Color="#FF343A40"/>
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FFDEE2E6"/>
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF6C757D"/>
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#FF007BFF"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#FF0056B3"/>
        <SolidColorBrush x:Key="AccentButtonBrush" Color="#FF28A745"/>
        <SolidColorBrush x:Key="AccentButtonHoverBrush" Color="#FF1E7E34"/>

        <Style x:Key="HeaderBackButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryActionTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{StaticResource AccentButtonBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryHeaderBrush}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource HeaderBackButton}"
                        Click="BackButton_Click"
                        ToolTip="Назад"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Назад" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="Список пациентов"
                           FontSize="22"
                           Foreground="{StaticResource LightTextBrush}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource CardBackgroundBrush}"
                Margin="15"
                Padding="15"
                CornerRadius="6"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="1" BlurRadius="6" Color="#FFBBBBBB" Opacity="0.25"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         FontSize="14"
                         BorderBrush="{StaticResource SubtleBorderBrush}"
                         BorderThickness="1"
                         Height="38"
                         TextChanged="SearchTextBox_TextChanged"
                         Background="White"
                         Margin="0,0,10,0">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Content="Поиск"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryActionButton}"
                        Width="110"
                        Margin="0,0,5,0"/>

                <Button Grid.Column="2"
                        Command="{Binding AddPatientCommand}"
                        Style="{StaticResource AccentActionButton}"
                        Click="Button_Click"
                        Width="Auto"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Добавить пациента" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource CardBackgroundBrush}"
                Margin="15,0,15,15"
                CornerRadius="6"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1">
            <ListView x:Name="lvPatient"
                      ItemsSource="{Binding Patient}"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      AlternationCount="2"
                      MouseDoubleClick="LvPatient_MouseDoubleClick">
                <ListView.View>
                    <GridView>
                        <GridView.ColumnHeaderContainerStyle>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
                            </Style>
                        </GridView.ColumnHeaderContainerStyle>

                        <GridViewColumn Header="ID"
                                        DisplayMemberBinding="{Binding ID_Пациента}"
                                        Width="70"/>
                        <GridViewColumn Header="Имя Фамилия"
                                        DisplayMemberBinding="{Binding ФИО_Пациента}"
                                        Width="220"/>
                        <GridViewColumn Header="Номер телефона"
                                        DisplayMemberBinding="{Binding NumPatient}"
                                        Width="160"/>
                        <GridViewColumn Header="Дата рождения"
                                        DisplayMemberBinding="{Binding DateBirh, StringFormat='dd.MM.yyyy'}"
                                        Width="140"/>
                        <GridViewColumn Header="Адрес"
                                        DisplayMemberBinding="{Binding AddressPatient}"
                                        />
                    </GridView>
                </ListView.View>

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PageBackgroundBrush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D007BFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
    </Grid>
</Page>